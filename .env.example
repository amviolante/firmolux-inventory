# Copy this to .env and fill in your values
# On Railway, set these as Environment Variables in the dashboard

# PostgreSQL — Railway provides this automatically if you add a Postgres plugin
DATABASE_URL=postgresql://user:password@host:5432/railway

# ShipStation API credentials — Firmolux account
# Used by /webhook/shipstation and /webhook/shipstation/firmolux
# Found in: ShipStation → Account Settings → API Settings
SHIPSTATION_API_KEY=your_api_key_here
SHIPSTATION_API_SECRET=your_api_secret_here

# ShipStation API credentials — VIOLANTE account
# Used by /webhook/shipstation/violante
VIOLANTE_SHIPSTATION_API_KEY=your_api_key_here
VIOLANTE_SHIPSTATION_API_SECRET=your_api_secret_here

# Optional: A shared secret to validate webhooks are really from ShipStation
# Set the same value in ShipStation webhook settings
SHIPSTATION_WEBHOOK_SECRET=

# Slack Incoming Webhook URL
# Created in: Slack → Apps → Incoming Webhooks → Add to Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/YYYY/ZZZZ

# Dashboard password (change this!)
ADMIN_PASSWORD=firmolux2024

# Port (Railway sets this automatically)
PORT=3000

# ─── Color Match (customer-facing form at /color-match) ──────────────────────
# Slack bot token for posting to the color-match channel. Required to store the
# message ts for later threading. chat:write scope needed; bot must be in the
# channel below.
SLACK_BOT_TOKEN=xoxb-...
COLOR_MATCH_SLACK_CHANNEL=#color-matches

# Resend (transactional email). Domain in COLOR_MATCH_FROM must be verified.
RESEND_API_KEY=
COLOR_MATCH_FROM=Firmolux <colors@firmolux.com>
COLOR_MATCH_REPLY_TO=

# Multi-line warehouse address. Shown on the confirmation page and in the email.
# Use \n for line breaks when setting via a single-line env value.
WAREHOUSE_ADDRESS="Firmolux Color Lab\n123 Example St\nPalmetto, FL 34221"
